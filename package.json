		"lucide-react": "^0.562.0",
		"next": "15.5.6",
		"react": "19.1.0",
		"react-dom": "19.1.0",
		"react-hot-toast": "^2.6.0",
		"react-icons": "^5.5.0",
		"stripe": "^20.1.2",
		"zod": "^4.3.5"
	},
	"devDependencies": {
		"@eslint/eslintrc": "^3.3.3",
		"@tailwindcss/postcss": "^4.1.18",
		"@types/node": "^20.19.27",
		"@types/react": "^19.2.7",
		"@types/react-dom": "^19.2.3",
		"eslint": "^9.39.2",
		"eslint-config-next": "15.4.6",
