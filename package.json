{
	"name": "next",
	"version": "0.1.0",
	"private": true,
	"scripts": {
		"dev": "next dev --turbopack --port 3001",
		"build": "next build",
		"start": "next start",
		"lint": "next lint",
		"deploy": "opennextjs-cloudflare build && wrangler deploy",
		"deploy:dev": "opennextjs-cloudflare build && wrangler deploy --env dev",
		"upload": "opennextjs-cloudflare build && opennextjs-cloudflare upload",
		"preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
		"cf-typegen": "wrangler types --env-interface CloudflareEnv ./cloudflare-env.d.ts",
		"test:e2e": "playwright test",
		"test:e2e:ui": "playwright test --ui",
		"test:e2e:headed": "playwright test --headed",
		"test:e2e:debug": "playwright test --debug",
		"test:e2e:auth": "playwright test e2e/auth.spec.ts",
		"test:e2e:api": "playwright test e2e/api.spec.ts",
		"test:e2e:nav": "playwright test e2e/navigation.spec.ts",
		"test:e2e:a11y": "playwright test e2e/accessibility.spec.ts",
		"test:e2e:visual": "playwright test e2e/visual.spec.ts",
		"test:e2e:perf": "playwright test e2e/performance.spec.ts",
		"test:e2e:onboarding": "playwright test e2e/onboarding.spec.ts",
		"test:e2e:security": "playwright test e2e/security.spec.ts",
		"test:e2e:report": "playwright show-report",
		"test:e2e:chromium": "playwright test --project=chromium",
		"test:e2e:firefox": "playwright test --project=firefox",
		"test:e2e:webkit": "playwright test --project=webkit"
	},
	"dependencies": {
		"@b3-crow/ui-kit": "^0.0.34",
		"@opennextjs/cloudflare": "1.16.1",
		"@radix-ui/react-popover": "^1.1.15",
		"@tanstack/react-query": "^5.90.16",
		"@tanstack/react-query-devtools": "^5.91.2",
		"better-auth": "^1.4.12",
		"class-variance-authority": "^0.7.1",
		"clsx": "^2.1.1",
		"framer-motion": "^12.24.10",
		"lucide-react": "^0.563.0",
		"next": "15.5.10",
		"react": "19.1.0",
		"react-dom": "19.1.0",
		"react-hot-toast": "^2.6.0",
		"react-icons": "^5.5.0",
		"stripe": "^20.1.2",
		"tailwind-merge": "^3.4.0",
		"zod": "^4.3.5",
		"zustand": "^5.0.10"
	},
	"devDependencies": {
		"@eslint/eslintrc": "^3.3.3",
		"@playwright/test": "^1.58.2",
		"@tailwindcss/postcss": "^4.1.18",
		"@types/node": "^20.19.27",
		"@types/react": "^19.2.7",
		"@types/react-dom": "^19.2.3",
		"eslint": "^9.39.2",
		"eslint-config-next": "15.4.6",
		"tailwindcss": "^4.1.18",
		"tw-animate-css": "^1.4.0",
		"typescript": "^5.9.3",
		"wrangler": "^4.57.0"
	}
}
